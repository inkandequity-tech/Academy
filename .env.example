# Public site address, no trailing slash (used in certificate QR codes and emails)
NEXT_PUBLIC_SITE_URL=https://academy.ieqlaw.com

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard > Account & settings > API keys; use test keys first)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > secret you set for the payment.captured / order.paid events
RAZORPAY_WEBHOOK_SECRET=

# Course fee in rupees, GST included. Placeholder until the partners fix the fee.
COURSE_PRICE_INR=4999

# Comma-separated emails that can open /admin
ADMIN_EMAILS=
